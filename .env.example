# X Virality Engine — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# X (Twitter) API Bearer Token — required for tweet fetching
X_BEARER_TOKEN=

# Anthropic API Key — required for AI deep analysis (Claude)
ANTHROPIC_API_KEY=

# Flask session secret key (generate with: python -c "import os; print(os.urandom(32).hex())")
FLASK_SECRET_KEY=

# Comma-separated list of allowed X handles (lowercase, without @)
ALLOWED_HANDLES=
